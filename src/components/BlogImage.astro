---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  width?: number;
}

const { src, alt, caption, width = 700 } = Astro.props;
// Never upscale: a small source keeps its natural size.
const renderWidth = Math.min(width, src.width);

// Figures are numbered automatically in page order (CSS counter), so a
// leading "Figure 3." in the caption text is dropped to avoid saying it twice.
const captionText = caption.replace(/^Figure\s+\d+\.\s*/i, "");
---

<figure class="blog-figure">
  <div class="blog-figure-frame">
    <Image {src} {alt} width={renderWidth} data-zoom-src={src.src} />
  </div>
  <figcaption>
    <span class="blog-figure-label" aria-hidden="true"></span>
    {captionText}
  </figcaption>
</figure>

<style>
  :global(.post-content) {
    counter-reset: figure;
  }

  .blog-figure {
    counter-increment: figure;
    margin: 2rem 0;
    padding: 1rem 1rem 0.9rem;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .blog-figure-frame {
    display: flex;
    justify-content: center;
  }

  .blog-figure :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0;
    border-radius: 3px;
  }

  figcaption {
    margin-top: 0.85rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-link);
  }

  .blog-figure-label::before {
    content: "Fig. " counter(figure);
  }

  .blog-figure-label {
    margin-right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }
</style>
