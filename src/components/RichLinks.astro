---
// Enhances every link inside an element with the `rich-links` class:
// the link opens in a new tab, gets the target site's logo before the text,
// and gets a faint external-link arrow after it that darkens on hover.
// Desktop only: hovering an external link shows its Open Graph preview card.
// The previews come from public/link-previews.json (pnpm link-previews).
---

<style is:global>
  .rich-links a .link-favicon {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    margin: 0 0.3em 0 0;
    vertical-align: -0.12em;
    border: none;
    border-radius: 2px;
  }

  .rich-links a .link-external-icon {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.15em;
    vertical-align: 0.05em;
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }

  .rich-links a:hover .link-external-icon,
  .rich-links a:focus-visible .link-external-icon {
    opacity: 1;
  }

  .link-preview {
    box-sizing: border-box;
    position: absolute;
    z-index: 60;
    width: 320px;
    overflow: hidden;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
    color: var(--color-text);
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.14s ease, transform 0.14s ease;
  }

  .link-preview.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .link-preview-image {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    margin: 0;
    border: none;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-code-bg);
  }

  .link-preview-text {
    padding: 0.7rem 0.9rem 0.8rem;
  }

  .link-preview-site {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-link);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-preview-site img {
    width: 14px;
    height: 14px;
    margin: 0;
    border: none;
    border-radius: 2px;
  }

  .link-preview-title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .link-preview-desc {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-link);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const origin = window.location.origin;
  const externalIconSvg =
    '<svg aria-hidden="true" class="link-external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>';

  document.querySelectorAll<HTMLAnchorElement>(".rich-links a[href]").forEach((a) => {
    const href = a.getAttribute("href") || "";
    if (href.startsWith("#") || href.startsWith("mailto:")) return;
    // Callouts style their own links.
    if (a.closest("[data-no-rich-links]")) return;

    // Every link opens in a new tab.
    a.setAttribute("target", "_blank");
    a.setAttribute("rel", "noopener noreferrer");

    // Links that wrap an image keep their content as is.
    if (a.querySelector("img")) return;

    let url: URL;
    try {
      url = new URL(href, origin);
    } catch {
      return;
    }
    const isInternal = url.origin === origin;

    const favicon = document.createElement("img");
    favicon.className = "link-favicon";
    favicon.alt = "";
    favicon.width = 16;
    favicon.height = 16;
    favicon.loading = "lazy";
    favicon.decoding = "async";
    favicon.src = isInternal
      ? "/favicon-32x32.png"
      : `https://www.google.com/s2/favicons?domain=${encodeURIComponent(url.hostname)}&sz=32`;
    favicon.addEventListener("error", () => favicon.remove());
    a.prepend(favicon);

    a.insertAdjacentHTML("beforeend", externalIconSvg);
  });

  // Desktop hover previews for external links.
  type Preview = { title: string | null; description: string | null; image: string | null; siteName: string | null };
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (canHover) {
    let previews: Record<string, Preview> | null = null;
    let loading: Promise<void> | null = null;
    const load = () =>
      (loading ??= fetch("/link-previews.json")
        .then((r) => (r.ok ? r.json() : {}))
        .then((data) => {
          previews = data;
        })
        .catch(() => {
          previews = {};
        }));

    const card = document.createElement("div");
    card.className = "link-preview";
    card.setAttribute("aria-hidden", "true");
    document.body.appendChild(card);

    let timer: number | undefined;
    let current: HTMLAnchorElement | null = null;

    const hide = () => {
      window.clearTimeout(timer);
      card.classList.remove("is-open");
      current = null;
    };

    const show = (a: HTMLAnchorElement) => {
      const href = a.getAttribute("href") || "";
      const data = previews?.[href];
      if (!data || current !== a) return;
      let host = "";
      try {
        host = new URL(href).hostname.replace(/^www\./, "");
      } catch {
        return;
      }
      // Nothing worth showing beyond what the link text already says.
      if (!data.title && !data.description) return;

      card.innerHTML = "";
      if (data.image) {
        const img = document.createElement("img");
        img.className = "link-preview-image";
        img.alt = "";
        img.src = data.image;
        img.addEventListener("error", () => img.remove());
        card.append(img);
      }
      const text = document.createElement("div");
      text.className = "link-preview-text";
      const site = document.createElement("div");
      site.className = "link-preview-site";
      const icon = document.createElement("img");
      icon.alt = "";
      icon.src = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=32`;
      icon.addEventListener("error", () => icon.remove());
      site.append(icon, document.createTextNode(data.siteName ? `${data.siteName} · ${host}` : host));
      text.append(site);
      if (data.title) {
        const title = document.createElement("p");
        title.className = "link-preview-title";
        title.textContent = data.title;
        text.append(title);
      }
      if (data.description) {
        const desc = document.createElement("p");
        desc.className = "link-preview-desc";
        desc.textContent = data.description;
        text.append(desc);
      }
      card.append(text);

      // Below the link by default, above it when there is no room.
      card.style.left = "0px";
      card.style.top = "0px";
      const rect = a.getBoundingClientRect();
      const box = card.getBoundingClientRect();
      const margin = 12;
      let left = rect.left;
      left = Math.max(margin, Math.min(left, window.innerWidth - box.width - margin));
      let top = rect.bottom + 8;
      if (top + box.height > window.innerHeight - margin) top = rect.top - box.height - 8;
      card.style.left = `${left + window.scrollX}px`;
      card.style.top = `${top + window.scrollY}px`;
      card.classList.add("is-open");
    };

    document.querySelectorAll<HTMLAnchorElement>(".rich-links a[href^='http']").forEach((a) => {
      if (new URL(a.href).origin === origin || a.closest("[data-no-rich-links]")) return;
      a.addEventListener("mouseenter", () => {
        current = a;
        window.clearTimeout(timer);
        load();
        timer = window.setTimeout(() => {
          loading?.then(() => show(a));
        }, 350);
      });
      a.addEventListener("mouseleave", hide);
    });
    window.addEventListener("scroll", hide, { passive: true });
  }
</script>
