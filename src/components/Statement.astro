---
// A numbered formal statement as a callout card:
//   LEMMA 1 · P-bounded Decisions
//   Statement text.
// A <Proof> placed right after it attaches to the bottom of the card.
// Put the statement text on the same line as the tags so MDX keeps it inline.
interface Props {
  kind: "Definition" | "Lemma" | "Theorem" | "Conjecture" | "Axiom" | "Property";
  n: number | string;
  name?: string;
}

const { kind, n, name } = Astro.props;
---

<div class="statement">
  <div class="statement-label">
    <span class="statement-kind">{kind} {n}</span>{name && <span class="statement-name"> · {name}</span>}
  </div>
  <p class="statement-body"><slot /></p>
</div>

<style>
  .statement {
    margin: 1.75rem 0;
    padding: 0.9rem 1.25rem 1rem;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  /* Square off the bottom when a proof is attached below */
  .statement:has(+ :global(.proof)) {
    margin-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .statement-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-link);
    margin-bottom: 0.4rem;
  }

  .statement-kind {
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text);
  }

  .statement-body {
    margin: 0;
    line-height: 1.65;
    color: var(--color-text);
  }
</style>
