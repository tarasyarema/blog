---
// A numbered formal statement as a callout card:
//   LEMMA 1 · P-bounded Decisions
//   Statement text.
// A <Proof> placed right after it attaches to the bottom of the card.
// Put the statement text on the same line as the tags so MDX keeps it inline.
interface Props {
  kind: "Definition" | "Lemma" | "Theorem" | "Conjecture" | "Axiom" | "Property" | "Example";
  n: number | string;
  name?: string;
}

const { kind, n, name } = Astro.props;
// Anchor for <Ref to="lemma-1">, e.g. "lemma-1", "property-2".
const id = `${kind.toLowerCase()}-${n}`;
---

<div class="statement" id={id} data-statement-label={`${kind} ${n}${name ? ` · ${name}` : ""}`}>
  <div class="statement-label">
    <span class="statement-kind">{kind} {n}</span>{name && <span class="statement-name"> · {name}</span>}
  </div>
  <p class="statement-body"><slot /></p>
</div>

<style>
  .statement {
    scroll-margin-top: 5rem;
    margin: 1.75rem 0;
    padding: 0.9rem 1.25rem 1rem;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  /* Square off the bottom when a proof is attached below */
  .statement:has(+ :global(.proof)) {
    margin-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  /* Brief highlight after jumping here from a <Ref> */
  .statement:global(.is-flash) {
    animation: statement-flash 1.6s ease;
  }

  @keyframes statement-flash {
    0%, 30% {
      border-color: var(--color-text);
      box-shadow: 0 0 0 3px var(--color-border);
    }
    100% {
      box-shadow: 0 0 0 3px transparent;
    }
  }

  .statement-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-link);
    margin-bottom: 0.4rem;
  }

  .statement-kind {
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text);
  }

  .statement-body {
    margin: 0;
    line-height: 1.65;
    color: var(--color-text);
  }
</style>
