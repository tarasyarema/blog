---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "A minimal blog", image = "/og-image.png" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />

    <!-- Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400;600;700&family=Roboto+Mono:wght@400;500&family=STIX+Two+Text:ital,wght@0,400;0,600;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <style>
      :root {
        /* Vintage paper — warm off-white, near-black ink */
        --color-bg: #f3ece0;
        --color-paper: #ece3d2;
        --color-text: #1a1611;
        --color-text-soft: #2a241c;
        --color-link: #5a4f3f;
        --color-link-hover: #1a1611;
        --color-border: #c9bda4;
        --color-rule: #b3a586;
        --color-code-bg: #e6dcc4;
        --color-code-border: #c9bda4;
        --color-fade: 243, 236, 224;
        --color-accent: #1a1611;
        --max-width: 900px;
        --font-display: "Funnel Display", sans-serif;
        --font-mono: "Roboto Mono", monospace;
        --font-math: "STIX Two Text", "Iowan Old Style", Palatino, Georgia, serif;
      }

      :root[data-theme="dark"] {
        /* Inverted ink — old typewriter ribbon on aged carbon */
        --color-bg: #14110b;
        --color-paper: #1d1812;
        --color-text: #ede4cf;
        --color-text-soft: #c9bea4;
        --color-link: #a89c84;
        --color-link-hover: #ede4cf;
        --color-border: #3a3226;
        --color-rule: #4a4030;
        --color-code-bg: #1f1a13;
        --color-code-border: #3a3226;
        --color-fade: 20, 17, 11;
        --color-accent: #ede4cf;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        padding-left: env(safe-area-inset-left, 0px);
        padding-right: env(safe-area-inset-right, 0px);
        font-family: var(--font-display);
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        font-size: 18px;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      a {
        color: var(--color-link);
        text-decoration: none;
        transition: color 0.2s, text-decoration-color 0.2s;
      }

      a:hover {
        color: var(--color-link-hover);
        text-decoration-color: var(--color-link-hover);
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
      }

      /* Inline code styling */
      p code,
      li code {
        background-color: var(--color-code-bg);
        border: 1px solid var(--color-code-border);
        padding: 0.1em 0.4em;
        border-radius: 2px;
        font-size: 0.85em;
        color: var(--color-text);
      }

      /* Search input styling */
      input[type="text"] {
        outline: none;
        border-color: var(--color-text);
        background-color: var(--color-bg);
        color: var(--color-text);
      }

      input[type="text"]:focus {
        outline: 1px solid var(--color-text);
        border-color: var(--color-text);
        box-shadow: none;
      }

      /* Image styling */
      img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 2rem auto;
        border-radius: 2px;
        border: 1px solid var(--color-border);
        filter: grayscale(0.35) contrast(0.96) sepia(0.08);
        transition: opacity 0.3s ease, filter 0.3s ease;
      }

      img:hover {
        opacity: 0.95;
      }

      /* Astro Image component */
      astro-image {
        display: block;
      }

      astro-image img {
        max-width: 100%;
        height: auto;
      }

      /* Page-edge fade gradients */
      .page-fade {
        position: fixed;
        left: 0;
        right: 0;
        height: 80px;
        pointer-events: none;
        z-index: 30;
      }

      .page-fade--top {
        top: 0;
        background: linear-gradient(
          to bottom,
          rgba(var(--color-fade), 1) 0%,
          rgba(var(--color-fade), 0) 100%
        );
      }

      .page-fade--bottom {
        bottom: 0;
        background: linear-gradient(
          to top,
          rgba(var(--color-fade), 1) 0%,
          rgba(var(--color-fade), 0) 100%
        );
      }

      /* Desktop floating buttons (back to top + theme) */
      .floating-stack {
        position: fixed;
        bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
        right: calc(1.5rem + env(safe-area-inset-right, 0px));
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        z-index: 100;
      }

      .floating-btn {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        border: 1px solid var(--color-rule);
        background-color: var(--color-paper);
        color: var(--color-text);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-size: 1rem;
        line-height: 1;
        transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
        box-shadow: 0 1px 0 var(--color-rule), 0 2px 10px rgba(26, 22, 17, 0.1);
      }

      .floating-btn:hover {
        background-color: var(--color-code-bg);
      }

      #back-to-top {
        opacity: 0;
        pointer-events: none;
        transform: translateY(8px);
      }

      #back-to-top.is-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
      }

      /* Below 1180px (no side TOC) the morphing menu replaces the round buttons */
      @media (max-width: 1179px) {
        .floating-stack {
          display: none;
        }
      }

      @media (min-width: 1180px) {
        .fab {
          display: none !important;
        }
      }

      /* One floating button that morphs into a small menu (contents, back to top, theme) */
      .fab {
        position: fixed;
        /* Stay clear of the iPhone home indicator and the rounded screen corners */
        bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
        right: calc(1.5rem + env(safe-area-inset-right, 0px));
        z-index: 100;
        width: 2.75rem;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--color-rule);
        border-radius: 1.375rem;
        background-color: var(--color-paper);
        color: var(--color-text);
        box-shadow: 0 1px 0 var(--color-rule), 0 2px 10px rgba(26, 22, 17, 0.1);
        transition:
          width 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
          border-radius 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
          box-shadow 0.28s ease;
      }

      .fab.is-open {
        width: 12.5rem;
        border-radius: 14px;
        box-shadow: 0 1px 0 var(--color-rule), 0 12px 32px rgba(26, 22, 17, 0.18);
      }

      /* The menu grows in height from 0 with the grid-rows trick */
      .fab-panel {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      .fab.is-open .fab-panel {
        grid-template-rows: 1fr;
      }

      .fab-items {
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 0;
        opacity: 0;
        transition: opacity 0.15s ease, padding 0.28s ease;
      }

      .fab.is-open .fab-items {
        padding: 0.35rem 0.35rem 0;
        opacity: 1;
        transition: opacity 0.2s ease 0.08s, padding 0.28s ease;
      }

      :global(.fab-item) {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
        padding: 0.6rem 0.65rem;
        border: none;
        border-radius: 9px;
        background: transparent;
        color: var(--color-text);
        font-family: var(--font-display);
        font-size: 0.92rem;
        line-height: 1.2;
        text-align: left;
        white-space: nowrap;
        cursor: pointer;
      }

      :global(.fab-item:hover),
      :global(.fab-item:focus-visible) {
        background-color: var(--color-code-bg);
        outline: none;
      }

      :global(.fab-item-icon) {
        width: 1.1rem;
        flex: none;
        display: inline-flex;
        justify-content: center;
      }

      .fab-trigger {
        flex: none;
        align-self: flex-end;
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: var(--color-text);
        cursor: pointer;
      }

      .fab-trigger-icon {
        position: relative;
        width: 16px;
        height: 16px;
      }

      /* Three dots that turn into a cross */
      .fab-trigger-icon span {
        position: absolute;
        top: 7px;
        width: 4px;
        height: 2px;
        border-radius: 1px;
        background-color: currentColor;
        transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.28s ease, left 0.28s ease, opacity 0.2s ease;
      }

      .fab-trigger-icon span:nth-child(1) { left: 0; }
      .fab-trigger-icon span:nth-child(2) { left: 6px; }
      .fab-trigger-icon span:nth-child(3) { left: 12px; }

      .fab.is-open .fab-trigger-icon span:nth-child(1) {
        left: 0;
        width: 16px;
        transform: rotate(45deg);
      }

      .fab.is-open .fab-trigger-icon span:nth-child(2) {
        opacity: 0;
      }

      .fab.is-open .fab-trigger-icon span:nth-child(3) {
        left: 0;
        width: 16px;
        transform: rotate(-45deg);
      }

      @media (prefers-reduced-motion: reduce) {
        .fab,
        .fab-panel,
        .fab-items,
        .fab-trigger-icon span {
          transition: none !important;
        }
      }

      .theme-icon-dark,
      :root[data-theme="dark"] .theme-icon-light {
        display: none;
      }

      :root[data-theme="dark"] .theme-icon-dark {
        display: inline-flex;
      }
    </style>

    <style is:global>
      blockquote {
        margin: 2rem 0;
        padding: 0.25rem 0 0.25rem 1.5rem;
        border-left: 3px solid var(--color-text);
        line-height: 1.55;
        color: var(--color-text);
        font-style: italic;
      }

      blockquote p {
        margin: 0;
      }

      blockquote p + p {
        margin-top: 0.75rem;
      }

      blockquote a {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* Expressive Code blocks */
      .expressive-code {
        margin: 1.75rem 0;
      }

      hr {
        border: none;
        border-top: 1px solid var(--color-rule);
        margin: 2.5rem 0;
      }

      h1, h2, h3, h4, h5, h6 {
        color: var(--color-text);
      }

      /* Prose link underlines — vintage typewriter feel */
      .post-content a,
      .prose a {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        text-decoration-color: var(--color-rule);
        transition: color 0.2s, text-decoration-color 0.2s;
      }

      .post-content a:hover,
      .prose a:hover {
        color: var(--color-link-hover);
        text-decoration-color: var(--color-link-hover);
      }
    </style>
  </head>
  <body>
    <div class="page-fade page-fade--top"></div>

    <slot />

    <div class="page-fade page-fade--bottom"></div>

    <!-- Desktop: two round buttons. Below 1180px the morphing menu (.fab) replaces them. -->
    <div class="floating-stack">
      <button id="back-to-top" class="floating-btn" data-action="top" type="button" aria-label="Back to top" title="Back to top">↑</button>
      <button id="theme-toggle" class="floating-btn" data-action="theme" type="button" aria-label="Toggle theme" title="Toggle theme">
        <span class="theme-icon-light" aria-hidden="true">☾</span>
        <span class="theme-icon-dark" aria-hidden="true">☀</span>
      </button>
    </div>

    <div class="fab" id="fab">
      <div class="fab-panel" id="fab-panel">
        <div class="fab-items" role="menu" aria-label="Page actions">
          <slot name="floating" />
          <button class="fab-item" data-action="top" type="button" role="menuitem" tabindex="-1">
            <span class="fab-item-icon" aria-hidden="true">↑</span> Back to top
          </button>
          <button class="fab-item" data-action="theme" type="button" role="menuitem" tabindex="-1">
            <span class="theme-icon-light"><span class="fab-item-icon" aria-hidden="true">☾</span>&nbsp;Dark mode</span>
            <span class="theme-icon-dark"><span class="fab-item-icon" aria-hidden="true">☀</span>&nbsp;Light mode</span>
          </button>
        </div>
      </div>
      <button
        id="fab-trigger"
        class="fab-trigger"
        type="button"
        aria-label="Page actions"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="fab-panel"
      >
        <span class="fab-trigger-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>

    <script>
      const fab = document.getElementById("fab");
      const fabTrigger = document.getElementById("fab-trigger");
      const fabItems = () =>
        Array.from(fab?.querySelectorAll<HTMLElement>(".fab-item") ?? []).filter(
          (item) => item.offsetParent !== null
        );

      const setFabOpen = (open: boolean) => {
        if (!fab || !fabTrigger) return;
        fab.classList.toggle("is-open", open);
        fabTrigger.setAttribute("aria-expanded", String(open));
        fab.querySelectorAll<HTMLElement>(".fab-item").forEach((item) => {
          item.tabIndex = open ? 0 : -1;
        });
        if (open) fabItems()[0]?.focus({ preventScroll: true });
      };

      fabTrigger?.addEventListener("click", () => {
        setFabOpen(!fab?.classList.contains("is-open"));
      });
      // Any action closes the menu.
      fab?.addEventListener("click", (event) => {
        const item = (event.target as HTMLElement).closest(".fab-item");
        if (item) setFabOpen(false);
      });
      document.addEventListener("click", (event) => {
        if (fab && !fab.contains(event.target as Node)) setFabOpen(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && fab?.classList.contains("is-open")) {
          setFabOpen(false);
          fabTrigger?.focus();
        }
      });

      document.querySelectorAll('[data-action="theme"]').forEach((button) =>
        button.addEventListener("click", () => {
          const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
        })
      );

      document.querySelectorAll('[data-action="top"]').forEach((button) =>
        button.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        })
      );

      // Desktop: the back-to-top button shows after the first screen.
      const backToTop = document.getElementById("back-to-top");
      const onScroll = () => backToTop?.classList.toggle("is-visible", window.scrollY > 400);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-BcpYxVF-lMSX5isLmCyLI.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </body>
</html>
