---
import BaseLayout from "./BaseLayout.astro";
import RichLinks from "../components/RichLinks.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface RelatedPost {
  id: string;
  title: string;
  subtitle: string;
  date: Date;
}

interface Props {
  title: string;
  subtitle: string;
  date: Date;
  tags: string[];
  description?: string;
  image?: string;
  readTimeLabel: string;
  headings: Heading[];
  related: RelatedPost[];
}

const {
  title,
  subtitle,
  date,
  tags,
  description,
  image,
  readTimeLabel,
  headings,
  related,
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description || subtitle} image={image}>
  <main class="post-main">
    <article>
        <header style="margin-bottom: 3rem;">
          <div style="margin-bottom: 1.5rem;">
            <a href="/" style="font-size: 0.875rem; color: var(--color-link);">← Back to posts</a>
          </div>

          <h1 id="post-title" style="font-size: 2.5rem; margin-bottom: 0.5rem; line-height: 1.2;">
            {title}
          </h1>

          <p style="font-size: 1.25rem; color: var(--color-link); margin-bottom: 1rem;">
            {subtitle}
          </p>

          <p style="color: var(--color-link); font-size: 0.95rem;">
            {formattedDate} · {readTimeLabel}
          </p>

          {tags.length > 0 && (
            <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
              {tags.map((tag) => (
                <a
                  href={`/tags/${tag}`}
                  style="
                    display: inline-block;
                    padding: 0.25rem 0.75rem;
                    border: 1px solid var(--color-text);
                    border-radius: 2px;
                    font-size: 0.85rem;
                    color: var(--color-text);
                  "
                >
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <div class="post-content rich-links" style="font-size: 1.05rem; line-height: 1.8; color: var(--color-text);">
          <slot />
        </div>

        <section class="related-section" aria-labelledby="related-heading">
          <h2 id="related-heading" style="font-size: 1.25rem; margin-bottom: 1rem;">
            Related articles
          </h2>
          {related.length > 0 ? (
            <ul style="list-style: none; padding: 0; margin: 0;">
              {related.map((post) => (
                <li style="padding: 0.75rem 0; border-bottom: 1px solid var(--color-border);">
                  <a href={`/blog/${post.id}`} style="text-decoration: none; color: inherit; display: block;">
                    <div style="font-size: 1.05rem; color: var(--color-text); margin-bottom: 0.15rem;">
                      {post.title}
                    </div>
                    <div style="font-size: 0.9rem; color: var(--color-link);">
                      {post.subtitle}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p style="color: var(--color-link); font-size: 0.95rem;">
              No related articles yet.
            </p>
          )}
        </section>
      </article>
    </main>

    {tocHeadings.length > 0 && (
      <aside class="post-toc" aria-label="Table of contents">
        <div class="post-toc-divider"></div>
        <div class="post-toc-inner">
          <div class="post-toc-title" id="post-toc-title" data-title={title} aria-hidden="true">
            {title}
          </div>
          <nav>
            <ul>
              {tocHeadings.map((h) => (
                <li class={`toc-depth-${h.depth}`}>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}

    {tocHeadings.length > 0 && (
      <button
        slot="floating"
        id="toc-toggle"
        class="fab-item toc-toggle"
        type="button"
        role="menuitem"
        tabindex="-1"
        aria-controls="toc-sheet"
      >
        <span class="fab-item-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01" /></svg>
        </span>
        Contents
      </button>
    )}

    {tocHeadings.length > 0 && (
      <dialog id="toc-sheet" class="toc-sheet" aria-label="Table of contents">
        <div class="toc-sheet-inner">
          <div class="toc-sheet-head">
            <span class="toc-sheet-title">{title}</span>
            <button type="button" class="toc-sheet-close" aria-label="Close">×</button>
          </div>
          <nav>
            <ul>
              {tocHeadings.map((h) => (
                <li class={`toc-depth-${h.depth}`}>
                  <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </dialog>
    )}

    <RichLinks />

    <dialog id="img-zoom" class="img-zoom" aria-label="Enlarged image">
      <button type="button" class="img-zoom-close" aria-label="Close">×</button>
      <img id="img-zoom-img" alt="" />
    </dialog>
</BaseLayout>

<style>
  .post-main {
    padding: 3rem 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .related-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  /* Fixed TOC pinned to the right of the article, full-viewport-height divider */
  .post-toc {
    display: none;
  }

  @media (min-width: 1180px) {
    .post-toc {
      display: block;
      position: fixed;
      top: 0;
      bottom: 0;
      /* Article column ends at (50vw + max-width/2). Add a gutter, then place TOC. */
      left: calc(50vw + var(--max-width) / 2 + 2rem);
      width: 220px;
      pointer-events: none;
      z-index: 20;
    }

    .post-toc-divider {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 1px;
      background-color: var(--color-rule);
    }

    .post-toc-inner {
      position: absolute;
      top: 50%;
      left: 1rem;
      right: 0;
      transform: translateY(-50%);
      font-size: 0.85rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      scrollbar-width: thin;
      pointer-events: auto;
    }
  }

  .post-toc-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 0 solid var(--color-rule);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    max-height: 0;
    margin-bottom: 0;
    padding-bottom: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, max-height 0.2s ease,
      margin-bottom 0.2s ease, padding-bottom 0.2s ease;
    pointer-events: none;
  }

  .post-toc-title.is-visible {
    opacity: 1;
    transform: translateY(0);
    max-height: 3rem;
    margin-bottom: 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom-width: 1px;
  }

  /* Vertical rail on the left of the TOC. The active item darkens its segment. */
  .post-toc nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--color-rule);
  }

  .post-toc nav li {
    margin: 0;
  }

  .post-toc .toc-depth-3 a {
    padding-left: 1.6rem;
    font-size: 0.8rem;
  }

  .post-toc nav a {
    color: var(--color-link);
    line-height: 1.4;
    display: block;
    padding: 0.3rem 0.5rem 0.3rem 0.85rem;
    margin-left: -3px;
    border-left: 4px solid transparent;
    border-radius: 0 2px 2px 0;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .post-toc nav a:hover {
    color: var(--color-link-hover);
    text-decoration: none;
  }

  .post-toc nav a.is-active {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    border-left-color: var(--color-text);
    background-color: var(--color-paper);
  }

  /* Math variables (P, P*, N) in a LaTeX-like serif italic */
  .post-content :global(var) {
    font-family: var(--font-math);
    font-style: italic;
    font-size: 1.08em;
    padding: 0 0.04em;
  }

  /* Mobile TOC: a floating button opens a bottom sheet. Hidden where the side TOC shows. */
  @media (min-width: 1180px) {
    .toc-toggle {
      display: none !important;
    }
  }

  .toc-sheet {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 100%;
    max-height: 75vh;
    margin: 0;
    padding: 0;
    border: none;
    border-top: 1px solid var(--color-rule);
    border-radius: 12px 12px 0 0;
    background-color: var(--color-paper);
    color: var(--color-text);
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.15);
  }

  .toc-sheet::backdrop {
    background: rgba(10, 8, 5, 0.45);
  }

  .toc-sheet-inner {
    padding: 1rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    max-height: 75vh;
    overflow-y: auto;
  }

  .toc-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .toc-sheet-title {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .toc-sheet-close {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .toc-sheet ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--color-rule);
  }

  .toc-sheet a {
    display: block;
    padding: 0.6rem 0.5rem 0.6rem 0.9rem;
    margin-left: -3px;
    border-left: 4px solid transparent;
    color: var(--color-link);
    font-size: 1rem;
    text-decoration: none;
  }

  .toc-sheet .toc-depth-3 a {
    padding-left: 1.75rem;
    font-size: 0.92rem;
  }

  .toc-sheet a.is-active {
    color: var(--color-text);
    font-weight: 600;
    border-left-color: var(--color-text);
    background-color: var(--color-bg);
  }

  /* Land headings below the fixed top fade when jumping to them */
  .post-content :global(h2),
  .post-content :global(h3) {
    scroll-margin-top: 5rem;
  }

    /* Click-to-zoom for every image in the post body */
  .post-content :global(img[data-zoomable]) {
    cursor: zoom-in;
  }

  .img-zoom {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 2rem;
    border: none;
    background: transparent;
    box-sizing: border-box;
    cursor: zoom-out;
  }

  .img-zoom[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .img-zoom::backdrop {
    background: rgba(10, 8, 5, 0.88);
  }

  .img-zoom img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: 0;
    border: none;
    border-radius: 2px;
    /* Paper background so transparent diagrams stay readable on the dark backdrop */
    background: var(--color-bg);
  }

  .img-zoom-close {
    position: fixed;
    top: 1rem;
    right: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(237, 228, 207, 0.4);
    border-radius: 50%;
    background: transparent;
    color: #ede4cf;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .img-zoom-close:focus {
    outline: none;
  }

  .img-zoom-close:focus-visible {
    outline: 2px solid #ede4cf;
    outline-offset: 2px;
  }
</style>

<script>
  // Click any image in the post to see it full screen.
  const zoomDialog = document.getElementById("img-zoom") as HTMLDialogElement | null;
  const zoomImg = document.getElementById("img-zoom-img") as HTMLImageElement | null;
  if (zoomDialog && zoomImg) {
    const images = document.querySelectorAll<HTMLImageElement>(
      ".post-content img:not(.link-favicon)"
    );
    images.forEach((img) => {
      if (img.closest("a") || img.closest("[data-no-zoom]")) return;
      img.dataset.zoomable = "true";
      img.addEventListener("click", () => {
        zoomImg.src = img.dataset.zoomSrc || img.currentSrc || img.src;
        zoomImg.alt = img.alt;
        zoomDialog.showModal();
      });
    });
    zoomDialog.addEventListener("click", () => zoomDialog.close());
    zoomDialog.addEventListener("close", () => {
      zoomImg.removeAttribute("src");
    });
  }

  const postTitleEl = document.getElementById("post-title");
  const tocTitleEl = document.getElementById("post-toc-title");
  if (postTitleEl && tocTitleEl) {
    const titleObserver = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        if (entry.isIntersecting) {
          tocTitleEl.classList.remove("is-visible");
        } else {
          tocTitleEl.classList.add("is-visible");
        }
      },
      { threshold: 0 }
    );
    titleObserver.observe(postTitleEl);
  }

  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".post-toc a[data-toc-link], .toc-sheet a[data-toc-link]")
  );
  if (tocLinks.length > 0) {
    // The desktop TOC and the mobile sheet list the same headings.
    const slugs = Array.from(new Set(tocLinks.map((l) => l.dataset.tocLink || "")));
    const headings = slugs
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => !!el);

    const setActive = (slug: string) => {
      tocLinks.forEach((l) => l.classList.toggle("is-active", l.dataset.tocLink === slug));
    };

    const sheet = document.getElementById("toc-sheet") as HTMLDialogElement | null;
    const sheetToggle = document.getElementById("toc-toggle");
    sheetToggle?.addEventListener("click", () => sheet?.showModal());
    sheet?.querySelector(".toc-sheet-close")?.addEventListener("click", () => sheet.close());
    // A tap on the backdrop (outside the panel) closes the sheet.
    sheet?.addEventListener("click", (event) => {
      if (event.target === sheet) sheet.close();
    });

    // Active section = the last heading above a line at 30% of the viewport.
    // At the very bottom of the page the last heading wins, since short final
    // sections can never scroll up to that line.
    const activationOffset = () => window.innerHeight * 0.3;
    const computeActive = () => {
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) return headings[headings.length - 1]?.id;
      let current = headings[0]?.id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= activationOffset()) current = h.id;
        else break;
      }
      return current;
    };

    // While a TOC click scrolls the page, keep the clicked item active.
    let lockedSlug: string | null = null;
    let unlockTimer: number | undefined;
    const unlock = () => {
      lockedSlug = null;
      window.clearTimeout(unlockTimer);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        if (lockedSlug) return;
        const slug = computeActive();
        if (slug) setActive(slug);
      });
    };

    tocLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const slug = link.dataset.tocLink || "";
        const target = document.getElementById(slug);
        if (!target) return;
        event.preventDefault();
        if (sheet?.open) sheet.close();
        lockedSlug = slug;
        setActive(slug);
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", `#${slug}`);
        window.clearTimeout(unlockTimer);
        unlockTimer = window.setTimeout(unlock, 1500);
      });
    });

    window.addEventListener("scrollend", () => {
      if (!lockedSlug) return;
      // Images above may have finished loading mid-scroll; land on the heading again.
      const target = document.getElementById(lockedSlug);
      if (target && Math.abs(target.getBoundingClientRect().top - parseFloat(getComputedStyle(target).scrollMarginTop || "0")) > 4) {
        target.scrollIntoView({ behavior: "auto", block: "start" });
      }
      unlock();
    });
    // A user scroll (wheel, touch, keys) releases the lock at once.
    ["wheel", "touchmove", "keydown"].forEach((type) =>
      window.addEventListener(type, unlock, { passive: true })
    );

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    onScroll();
  }
</script>
