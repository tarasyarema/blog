---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  subtitle: string;
  date: Date;
  tags: string[];
  description?: string;
  image?: string;
}

const { title, subtitle, date, tags, description, image } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description || subtitle} image={image}>
  <main style="padding: 3rem 1.5rem; max-width: var(--max-width); margin: 0 auto;">
    <article>
      <header style="margin-bottom: 3rem;">
        <div style="margin-bottom: 1.5rem;">
          <a href="/" style="font-size: 0.875rem; color: var(--color-link);">← Back to posts</a>
        </div>

        <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem; line-height: 1.2;">
          {title}
        </h1>

        <p style="font-size: 1.25rem; color: var(--color-link); margin-bottom: 1rem;">
          {subtitle}
        </p>

        <p style="color: var(--color-link); font-size: 0.95rem;">
          {formattedDate}
        </p>

        {tags.length > 0 && (
          <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                style="
                  display: inline-block;
                  padding: 0.25rem 0.75rem;
                  border: 1px solid var(--color-text);
                  border-radius: 2px;
                  font-size: 0.85rem;
                  color: var(--color-text);
                "
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      <div style="
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--color-text);
      ">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
