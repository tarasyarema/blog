---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tags = new Set();

  posts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      tags.add(tag);
    });
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const allPosts = await getCollection("blog");
const taggedPosts = allPosts.filter((post) =>
  post.data.tags.includes(tag)
);
const sortedPosts = taggedPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title={`Posts tagged with "${tag}"`}
  description={`All blog posts tagged with ${tag}`}
>
  <main style="padding: 3rem 1.5rem; max-width: var(--max-width); margin: 0 auto;">
    <header style="margin-bottom: 3rem;">
      <a href="/" style="font-size: 0.875rem; color: var(--color-link);">← Back to all posts</a>
      <h1 style="font-size: 2.5rem; margin: 1.5rem 0 0 0;">
        Posts tagged with <span style="border: 1px solid var(--color-text); padding: 0.25rem 0.75rem; border-radius: 2px;">#{tag}</span>
      </h1>
    </header>

    {
      sortedPosts.length > 0 ? (
        <div>
          {sortedPosts.map((post) => (
            <article style="margin-bottom: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid #e5e5e5;">
              <a href={`/blog/${post.id}`} style="text-decoration: none; color: inherit;">
                <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem; cursor: pointer;">
                  {post.data.title}
                </h2>
              </a>
              <p style="font-size: 1.1rem; color: var(--color-link); margin-bottom: 0.75rem;">
                {post.data.subtitle}
              </p>
              <p style="color: var(--color-link); font-size: 0.9rem;">
                {new Date(post.data.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
            </article>
          ))}
        </div>
      ) : (
        <p style="color: var(--color-link); font-size: 1.1rem; text-align: center; padding: 2rem 0;">
          No posts found with this tag.
        </p>
      )
    }
  </main>
</BaseLayout>
